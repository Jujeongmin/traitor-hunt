{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@agent8/gameserver-node"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "../src/game/account/**/*",
    "../src/game/world/**/*",
    "../src/game/combat/**/*",
    "../src/game/rules/**/*",
    "./node_modules/@agent8/gameserver-node/types/**/*.d.ts"
  ]
}
